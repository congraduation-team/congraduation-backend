# Copy to .env for local overrides. Never commit .env.

# App DB (must match docker-compose MySQL user)
DB_URL=jdbc:mysql://localhost:3307/congraduation?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=congraduation_user
DB_PASSWORD=congraduation_password

# docker-compose MySQL
MYSQL_DATABASE=congraduation
MYSQL_USER=congraduation_user
MYSQL_PASSWORD=congraduation_password
MYSQL_ROOT_PASSWORD=root_password

# Required in production (32+ characters)
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_JWT_EXPIRATION_SECONDS=43200

# Optional
JPA_SHOW_SQL=false
SPRINGDOC_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://congraduation-frontend.vercel.app

# Timetable GitHub sync (admin upload). Leave empty unless needed.
TIMETABLE_GITHUB_ENABLED=false
TIMETABLE_GITHUB_TOKEN=
TIMETABLE_GITHUB_OWNER=congraduation-team
TIMETABLE_GITHUB_REPO=congraduation-backend
TIMETABLE_GITHUB_BRANCH=main
